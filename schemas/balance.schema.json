{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/balance.schema.json",
  "title": "Herbal Line fictional game balance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "balanceVersion",
    "economy",
    "quality",
    "upgrades"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "balanceVersion": {
      "type": "string",
      "minLength": 1
    },
    "economy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "utilityRateCentsPerUnitHour",
        "operatingHoursPerCampaignDay"
      ],
      "properties": {
        "utilityRateCentsPerUnitHour": {
          "type": "integer",
          "minimum": 0
        },
        "operatingHoursPerCampaignDay": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseThreshold",
        "reviewThreshold",
        "contaminationPenaltyMultiplier"
      ],
      "properties": {
        "releaseThreshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "reviewThreshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "contaminationPenaltyMultiplier": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "upgrades": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "description",
          "costCents",
          "utilityReductionPercent"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "costCents": {
            "type": "integer",
            "minimum": 0
          },
          "utilityReductionPercent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "prerequisiteUpgradeId": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "uniqueItems": true
    }
  }
}
