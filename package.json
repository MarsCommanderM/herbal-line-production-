{
  "name": "herbal-line",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Herbal Line — a fictional botanical operations management game.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint-source.mjs",
    "format:check": "node scripts/check-format.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:masterpack": "python scripts/validate_masterpack.py",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.17.3",
    "pixi.js": "8.8.1",
    "three": "0.176.0"
  },
  "devDependencies": {
    "@types/three": "0.176.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.1.2",
    "@playwright/test": "1.52.0"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  }
}
